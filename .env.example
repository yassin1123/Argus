# =============================================================================
# Argus environment file
# Copy to `.env` (root) and `frontend/.env.local` before running.
# =============================================================================

# -----------------------------------------------------------------------------
# Demo mode — set to 1 to run without an OpenAI API key.
# `make demo` will set this for you. In demo mode the stack boots with
# pre-seeded engagements (see backend/scripts/seed_demo.py).
# -----------------------------------------------------------------------------
DEMO_MODE=0

# -----------------------------------------------------------------------------
# LLM + retrieval keys (required for full mode; ignored if DEMO_MODE=1)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
SERPAPI_KEY=
# Optional: Cohere rerank for retrieval (https://cohere.com)
COHERE_API_KEY=

# -----------------------------------------------------------------------------
# Web fetch gating (optional — comma-separated hostnames, no scheme)
# -----------------------------------------------------------------------------
# WEB_FETCH_ALLOWED_DOMAINS=sec.gov,reuters.com
# WEB_FETCH_BLOCKED_DOMAINS=facebook.com
# WEB_FETCH_MAX_BYTES=800000

# -----------------------------------------------------------------------------
# Strict evidence gates
# -----------------------------------------------------------------------------
# Require non-inference evidence for key_claims (1=true, 0=off)
# ARGUS_STRICT_NO_INFERENCE_ONLY=1
# Writer must link executive_insights / recommendation to analyst claim_ids
# ARGUS_STRICT_WRITER_CLAIM_IDS=1
# Reasoning skeleton config override path
# ARGUS_REASONING_SKELETONS_PATH=
# Min research tensions before forced analyst revision pre-verifier (default 3)
# ARGUS_CONTRADICTION_FORCE_REVISION_MIN=3
# Research v2: preferred-domain score boost + dedupe web URLs (best source wins)
# ARGUS_RESEARCH_V2=0
# ARGUS_RESEARCH_PREFERRED_DOMAINS=sec.gov,reuters.com

# -----------------------------------------------------------------------------
# Infra
# -----------------------------------------------------------------------------
SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/argus
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Frontend (Next.js) — must point at running API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

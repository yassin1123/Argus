{# W10/D3: 1-pager A4 print frame. Composes the partials. No JS — PDF-safe. #}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ engagement_title }} — 1-pager</title>
<style>
:root {
  --primary: {{ primary_color }};
  --secondary: {{ secondary_color }};
  --neutral: #1B1F23;
  --muted: #5b6470;
  --bg: #ffffff;
  --line: #d4d8de;
  --green: #0F6E56;
  --amber: #B8860B;
  --red:   #B91C1C;
  --font-stack: {{ font_family }};
}
@page { size: A4; margin: 14mm 12mm; }
html, body { background: var(--bg); }
body {
  font-family: var(--font-stack);
  color: var(--neutral);
  font-size: 10pt;
  line-height: 1.35;
  margin: 0;
  padding: 0;
  -webkit-print-color-adjust: exact;
  print-color-adjust: exact;
}
.recommendation, .recommendation.rec-green, .recommendation.rec-amber, .recommendation.rec-red {
  -webkit-print-color-adjust: exact;
  print-color-adjust: exact;
}
.page {
  width: 186mm;          /* A4 width minus 12mm margins */
  max-height: 269mm;     /* A4 height minus 14mm margins */
  margin: 0 auto;
  padding: 0;
  overflow: hidden;       /* enforce single-page contract */
}
.header {
  border-top: 4px solid var(--primary);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 12px 8px 12px;
  border-bottom: 1px solid var(--line);
}
.header .logo { font-weight: 700; font-size: 12pt; color: var(--primary); }
.header .logo img { max-height: 28px; vertical-align: middle; }
.header .meta { text-align: center; flex: 1; }
.header .meta .title { font-weight: 600; font-size: 11pt; }
.header .meta .target { color: var(--muted); font-size: 9pt; }
.header .prepared { font-size: 8.5pt; color: var(--muted); text-align: right; min-width: 140px; }
.recommendation {
  margin: 12px 0;
  padding: 12px 14px;
  border-left: 6px solid var(--neutral);
  background: #f7f8fa;
}
.recommendation.rec-green { border-left-color: var(--green); }
.recommendation.rec-amber { border-left-color: var(--amber); }
.recommendation.rec-red   { border-left-color: var(--red);   }
.recommendation .label { font-size: 8.5pt; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
.recommendation .text  { font-size: 12pt; font-weight: 600; margin-top: 4px; color: var(--neutral); }
.cols { display: flex; gap: 16px; margin-top: 8px; }
.col  { flex: 1; }
.col h2 {
  font-size: 10pt;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--primary);
  margin: 0 0 6px 0;
  border-bottom: 1px solid var(--line);
  padding-bottom: 3px;
}
.col ul { margin: 0; padding-left: 18px; }
.col li { margin-bottom: 4px; }
.supplement {
  margin-top: 10px;
  padding: 8px 12px;
  background: #fff;
  border: 1px solid var(--line);
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  font-size: 9.5pt;
}
.supplement .label { color: var(--muted); text-transform: uppercase; font-size: 8.5pt; letter-spacing: 0.06em; }
.supplement .value { font-weight: 600; }
.sources-panel {
  margin-top: 10px;
  padding-top: 8px;
  border-top: 1px solid var(--line);
  font-size: 8.5pt;
  color: var(--muted);
}
.sources-panel .counts span { margin-right: 14px; }
.citation-list {
  margin-top: 4px;
  font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  font-size: 7.5pt;
  color: var(--secondary);
  display: flex;
  flex-wrap: wrap;
  gap: 6px 14px;
}
.citation-list .ref {
  display: inline-block;
  border: 1px solid var(--line);
  padding: 1px 5px;
  border-radius: 2px;
  background: #fafbfc;
}
.citation-list sup { color: var(--primary); font-weight: 600; }
.footer {
  position: relative;
  margin-top: 12px;
  padding-top: 6px;
  border-top: 1px solid var(--line);
  font-size: 7.5pt;
  color: var(--muted);
  display: flex;
  justify-content: space-between;
}
.truncate-note { font-size: 8pt; color: var(--muted); font-style: italic; }
</style>
</head>
<body>
<div class="page">

{% include "_header.html.j2" %}

{% include "recommendation.html.j2" %}

{% include "reasons_risks.html.j2" %}

{% if mode == "m_and_a_diligence" %}
  {% include "m_and_a_supplement.html.j2" %}
{% elif mode == "growth_strategy" %}
  {% include "growth_strategy_supplement.html.j2" %}
{% endif %}

{% include "source_panel.html.j2" %}

<div class="footer">
  <span>{{ footer_text }}</span>
  <span>Generated by Argus · Every claim verified · Hover citations for source</span>
</div>

</div>
</body>
</html>

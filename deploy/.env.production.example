# =============================================================================
# Argus PRODUCTION environment — Phase 5 / Week 25 / Day 1.
#
# Copy to deploy/.env.production and fill in. NEVER commit the filled
# file. In a real deploy these come from a managed secret store (AWS
# Secrets Manager / GCP Secret Manager) injected at runtime, not a file
# on disk (W23 secrets rule).
# =============================================================================

# --- Mode (W23/W25 fail-loud) ------------------------------------------------
# production: the boot guard CRASH-LOOPS the container if the real
# cross-family verifier is unavailable. Never runs the heuristic.
ARGUS_MODE=production

# --- Public domain + TLS (Caddy auto-provisions the cert) --------------------
ARGUS_DOMAIN=app.yourfirm.example
PUBLIC_API_URL=https://app.yourfirm.example
ALLOWED_ORIGINS=https://app.yourfirm.example

# --- Managed Postgres with encryption-at-rest (W24 #1, #4) -------------------
# RDS / Cloud SQL / Azure DB. sslmode=require enforces TLS in transit.
# The DB user should be least-privilege (DML on app tables; no DDL, no
# audit-table mutation) once migrations are applied.
DATABASE_URL=postgresql://argus_app:CHANGE_ME@your-managed-db-host:5432/argus?sslmode=require

# --- Redis (bundled in the prod compose; override for a managed cache) -------
REDIS_URL=redis://redis:6379/0

# --- LLM provider keys (BOTH required — cross-family verifier) ----------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional third provider + web search:
GEMINI_API_KEY=
GOOGLE_API_KEY=
SERPAPI_KEY=
BRAVE_API_KEY=
COHERE_API_KEY=

# --- App secret (strong random; e.g. `openssl rand -hex 32`) -----------------
SECRET_KEY=

# --- Email (W18) — smtp in production --------------------------------------
ARGUS_EMAIL_ADAPTER=smtp
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Object storage: real S3 with default bucket encryption (W24 #2) ---------
ARGUS_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
ARGUS_S3_PUBLIC_ENDPOINT=https://your-bucket.s3.us-east-1.amazonaws.com
ARGUS_S3_REGION=us-east-1
ARGUS_S3_BUCKET=argus-prod-sources
ARGUS_S3_ACCESS_KEY=
ARGUS_S3_SECRET_KEY=

# --- Generated-artifact storage: an ENCRYPTED host volume (W24 #2) -----------
# Point at a path on an encrypted disk; the compose mounts it at
# /app/artifacts. Leave unset to use a Docker named volume (only
# acceptable if the host disk itself is encrypted).
# ARGUS_ARTIFACTS_HOST_DIR=/mnt/encrypted/argus-artifacts

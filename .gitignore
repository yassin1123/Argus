# Local artifact output dir — produced by the Wxx/D5 e2e runners.
# Generated .pdf/.pptx/.xlsx binaries are large and reproducible from
# the eval_runs JSONs + the source.
artifacts_out/

# Week 1 benchmark raw outputs — only the runner and summary.json/csv are committed.
backend/eval_runs/**/run_*.json
backend/eval_runs/**/run_*.md
backend/eval_runs/**/raw/

# Real-claim raw score caches embed full claim/evidence text from real
# engagement runs — re-runnable from the labelled golden fixture, so we
# keep the cache local. The labelled fixture + summary.json ARE committed.
backend/eval/calibration/raw_scores_*_real.json

# Dress-rehearsal transient synthetic library source (regenerated each
# run). Only summary.json is committed.
backend/eval_runs/week24_dress_rehearsal/_library_src/

# Week 3 / Day 5 e2e raw per-ticker captures (memos can hit ~1MB each, reproducible).
# Only summary.json is committed.
backend/eval_runs/week3_e2e/AAPL.json
backend/eval_runs/week3_e2e/MSFT.json
backend/eval_runs/week3_e2e/TSLA.json
backend/eval_runs/week3_e2e/*.failed.json

# Week 4 / Day 1 e2e — same shape as Week 3, only summary.json committed.
backend/eval_runs/week4_d1_e2e/AAPL.json
backend/eval_runs/week4_d1_e2e/MSFT.json
backend/eval_runs/week4_d1_e2e/TSLA.json
backend/eval_runs/week4_d1_e2e/*.failed.json

# Phase 1 exit demo — full per-target captures (memos + claims + chunks
# can be ~1MB each). Reproducible from the runner; only the wrap-up
# doc + a small numbers-only summary are committed.
backend/eval_runs/phase1_exit/AAPL.json
backend/eval_runs/phase1_exit/TSCO_LON.json
backend/eval_runs/phase1_exit/*.failed.json

# Week 5 / Day 5 firm-library e2e — same shape, only summary.json committed.
backend/eval_runs/week5_e2e/A_with_library.json
backend/eval_runs/week5_e2e/B_with_library.json
backend/eval_runs/week5_e2e/A_no_library.json

# Week 6 / Day 5 layered-modes e2e — same shape, only summary.json committed.
backend/eval_runs/week6_e2e/A_with_override.json
backend/eval_runs/week6_e2e/B_built_in.json

# Week 7 / Day 4-5 — heavy per-run captures + integration logs.
backend/eval_runs/week7_d4_integration/failed_session.json
w7d4_integration.log
w7d5_e2e.log
w7d5_run_b.log
w7d5_iterate*.log
w7d5_iterate_run.log
w7_iterate*.log
backend/eval_runs/week7_e2e/A_m_and_a.json
backend/eval_runs/week7_e2e/B_growth_strategy.json

# Week 8 / Day 5 frameworks-library e2e — same shape, only summary.json committed.
backend/eval_runs/week8_e2e/A_m_and_a.json
backend/eval_runs/week8_e2e/B_growth_strategy.json
